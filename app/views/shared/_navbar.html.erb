<nav class="bg-white shadow-md px-6 py-4 flex justify-between items-center">
  <div class="flex items-center space-x-3">
    <h1 class="text-2xl font-bold text-primary"><%= link_to "Dancing Partners", root_path %></h1>
    <span class="text-gray-500 hidden sm:inline">The First Worldwide Dancers Community</span>
  </div>

  <div class="flex items-center space-x-4">
    <% if user_signed_in? %>
      <%= link_to "Communauté", users_path, class: "text-gray-700 hover:text-primary font-medium" %>
      <%= link_to "Danses", dances_path, class: "text-gray-700 hover:text-primary font-medium" %>
      <%= link_to "Agenda", appointments_path, class: "text-gray-700 hover:text-primary font-medium" %>
      <%= link_to "Profil", user_path(current_user), class: "text-gray-700 hover:text-primary font-medium" %>
      <%= link_to "Déconnexion", destroy_user_session_path, method: :delete, class: "text-red-500 hover:text-red-600 font-medium" %>
      <div class="ml-4">
        <% if current_user.photo.attached? %>
          <%= cl_image_tag current_user.photo.key, class: "w-10 h-10 rounded-full border-2 border-primary" %>
        <% else %>
          <%= image_tag current_user.gender_image, class: "w-10 h-10 rounded-full border-2 border-primary" %>
        <% end %>
      </div>
    <% else %>
      <%= link_to "Connexion", new_user_session_path, class: "text-gray-700 hover:text-primary font-medium" %>
      <%= link_to "Communauté", users_path, class: "text-gray-700 hover:text-primary font-medium" %>
      <%= link_to "Danses", dances_path, class: "text-gray-700 hover:text-primary font-medium" %>
      <%= link_to "Agenda", appointments_path, class: "text-gray-700 hover:text-primary font-medium" %>
    <% end %>
  </div>
</nav>
