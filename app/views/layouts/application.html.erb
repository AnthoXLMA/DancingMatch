<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dancing Partners</title>

  <%= csp_meta_tag %>
  <%= csrf_meta_tags %>

  <!-- Rails CSS & JS -->
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

  <%= javascript_importmap_tags %>

  <!-- Tailwind CSS (assurez-vous qu'il est bien compilé via Webpacker ou importmap) -->
  <!-- <link rel="stylesheet" href="/path/to/tailwind.css"> -->

  <!-- Mapbox GL JS -->
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.4.0/mapbox-gl.css" rel="stylesheet">
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.4.0/mapbox-gl.js" defer></script>

  <!-- Mapbox Geocoder Plugin -->
  <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.css" />
  <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js" defer></script>

  <!-- Mapbox CSS -->
<link href='https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.css' rel='stylesheet' />

<!-- Mapbox JS -->
<script src='https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.js'></script>


  <!-- Supprimer Bootstrap si TailwindCSS est utilisé -->
  <!-- <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"> -->
  <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.js"></script> -->

</head>
<body class="bg-gray-50 font-sans text-gray-800">

  <!-- NAVBAR -->
  <%= render 'shared/navbar' %>

  <!-- PAGE CONTENT -->
  <main class="pt-16">
    <%= yield %>
  </main>

  <!-- FOOTER -->
  <%= render 'shared/footer' %>

</body>
</html>
