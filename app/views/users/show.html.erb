<div class="max-w-6xl mx-auto p-6 space-y-8 font-sans text-gray-800">

  <!-- PROFILE HEADER -->
  <div class="flex flex-col md:flex-row items-center bg-gradient-to-r from-white via-gray-50 to-white shadow-xl rounded-2xl p-6 md:p-8 space-y-4 md:space-y-0 md:space-x-8">
    <div class="flex-shrink-0 relative">
      <% if @user.photo.attached? %>
        <%= cl_image_tag @user.photo.key, class: "w-36 h-36 rounded-full object-cover border-4 border-red-500 shadow-md" %>
      <% else %>
        <%= image_tag @user.gender_image, class: "w-36 h-36 rounded-full object-cover border-4 border-red-500 shadow-md" %>
      <% end %>
    </div>
    <div class="flex-1 space-y-2">
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-900"><%= @user.first_name %> <%= @user.last_name %></h1>
      <p class="text-gray-600 text-sm md:text-base"><%= @user.gender %> • <%= @user.age %> ans • <%= @user.location %></p>
      <p class="text-gray-600 text-sm md:text-base"><%= @user.experience %> ans d'expérience</p>
      <%= link_to "Éditer mon profil", edit_user_path(@user), class: "inline-block mt-2 px-6 py-2 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition shadow" %>
    </div>
  </div>

  <!-- MAP -->
  <div class="w-full h-96 rounded-2xl overflow-hidden shadow-xl ring-1 ring-gray-200">
    <div id="map" class="w-full h-full"></div>
    <script>
      const markers = <%= raw @markers.to_json %>;

      mapboxgl.accessToken = '<%= ENV['MAPBOX_API_KEY'] %>';
      const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v11',
        center: [<%= @user.longitude %>, <%= @user.latitude %>],
        zoom: 10
      });

      markers.forEach(marker => {
        new mapboxgl.Marker({ color: "#FF5A5F" })
          .setLngLat([marker.lng, marker.lat])
          .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(marker.infoWindow))
          .addTo(map);
      });
    </script>
  </div>

  <!-- MEMBERS GRID -->
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900">Membres</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
      <% if @users.present? %>
        <% @users.each do |user| %>
          <div class="bg-white rounded-2xl shadow p-4 flex flex-col items-center hover:shadow-2xl transition transform hover:-translate-y-1 duration-200">
            <% if user.photo.attached? %>
              <%= cl_image_tag user.photo.key, class: "w-24 h-24 rounded-full object-cover mb-2" %>
            <% else %>
              <%= image_tag user.gender_image, class: "w-24 h-24 rounded-full object-cover mb-2" %>
            <% end %>
            <p class="font-semibold text-center text-gray-900"><%= link_to user.first_name, user_profiles_path(user), class: "hover:text-red-500 transition" %></p>
            <p class="text-gray-500 text-sm"><%= user.location %></p>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-500">Aucun autre membre trouvé.</p>
      <% end %>
    </div>
  </div>

  <!-- PROFILES DANCES -->
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900">Mes profils danses</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <% if @user.profiles.present? %>
        <% @user.profiles.each do |profile| %>
          <div class="bg-white rounded-2xl shadow p-4 hover:shadow-2xl hover:bg-gradient-to-r hover:from-white hover:via-gray-50 hover:to-white transition duration-200">
            <h3 class="font-bold text-lg text-gray-900"><%= profile.dance.title %></h3>
            <ul class="text-gray-600 text-sm mt-2 space-y-1">
              <li>Investissement : <%= profile.investissement %></li>
              <li>Niveau : <%= profile.niveau %></li>
              <li>Training/week : <%= profile.training_per_week %></li>
            </ul>
            <div class="mt-2 flex space-x-2">
              <%= link_to "Edit", edit_profile_path(profile), class: "text-red-500 hover:underline text-sm" %>
              <%= button_to "Destroy", profile_path(profile), method: :delete, class: "text-gray-500 hover:underline text-sm" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-500">Vous n'avez pas encore sélectionné de profils danse.</p>
      <% end %>
    </div>
  </div>

  <!-- REQUESTS SENT & RECEIVED -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white rounded-2xl shadow p-4">
      <h2 class="font-bold text-xl mb-2 text-gray-900">Demandes envoyées</h2>
      <% if current_user.requests.present? %>
        <ul class="list-disc list-inside text-gray-600 space-y-1">
          <% current_user.requests.each do |r| %>
            <li><%= r.profile.dance.title %> avec <%= r.profile.user.first_name %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500">Aucune demande envoyée.</p>
      <% end %>
    </div>

    <div class="bg-white rounded-2xl shadow p-4">
      <h2 class="font-bold text-xl mb-2 text-gray-900">Demandes reçues</h2>
      <% if @dancing_partners.present? %>
        <ul class="list-disc list-inside text-gray-600 space-y-1">
          <% @dancing_partners.each do |dp| %>
            <li>
              <%= dp.user.first_name %> veut danser <%= dp.profile.dance.title %>
              <%= link_to "Voir la demande", requests_path(dp), class: "text-red-500 hover:underline ml-2" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500">Aucune demande reçue.</p>
      <% end %>
    </div>
  </div>

  <!-- APPOINTMENTS -->
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900">Mes événements</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% current_user.appointments.each do |event| %>
        <div class="bg-white rounded-2xl shadow p-4 flex items-start space-x-4 hover:shadow-2xl transition transform hover:-translate-y-1 duration-200">
          <% if event.pic.attached? %>
            <%= image_tag event.pic, class: "w-24 h-24 object-cover rounded-lg" %>
          <% end %>
          <div>
            <p class="font-bold text-lg text-gray-900"><%= event.name %></p>
            <p class="text-gray-600 text-sm"><%= event.start_on %></p>
            <p class="text-gray-600 text-sm"><%= event.address %></p>
            <%= link_to "Voir sur la carte", appointments_path, class: "text-red-500 hover:underline mt-1 inline-block text-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

</div>

<div id="map"
     data-mapbox-token="<%= ENV['MAPBOX_API_KEY'] %>"
     data-markers="<%= raw @markers.to_json %>"
     class="w-full h-96 rounded-xl shadow-lg">
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mapElement = document.getElementById('map');
    const markers = JSON.parse(mapElement.dataset.markers);
    const mapboxToken = mapElement.dataset.mapboxToken;

    mapboxgl.accessToken = mapboxToken;
    const map = new mapboxgl.Map({
      container: 'map',
      style: 'mapbox://styles/mapbox/streets-v11',
      center: [<%= @user.longitude %>, <%= @user.latitude %>],
      zoom: 10
    });

    markers.forEach(marker => {
      new mapboxgl.Marker({ color: "#FF5A5F" })
        .setLngLat([marker.lng, marker.lat])
        .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(marker.infoWindow))
        .addTo(map);
    });
  });
</script>

